rules_version = '2';

// FreshNest Laundry — Firestore Security Rules
// Phase 1 scope: users, customerProfiles, addresses, riders (skeleton).
// Every other collection in the full architecture (orders, payments,
// wallets, refundRequests, etc.) is intentionally left unmatched below,
// which means it falls through to the default-deny catch-all. Rule blocks
// for those collections are added only when each feature actually ships
// in its corresponding phase — this file is never "ahead" of what the
// backend can enforce.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isFinance() {
      return hasRole('finance');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True if the only fields being changed are within `allowed`.
    // This is how we prevent, e.g., a customer from smuggling a `role`
    // field write into an otherwise-legitimate profile update.
    function onlyChanging(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ---------- Default deny for anything not explicitly matched ----------
    // IMPORTANT: this must stay first/topmost conceptually — it does not
    // override the specific matches below because Firestore evaluates
    // every matching rule block and allows if ANY block grants the
    // operation. Collections with no dedicated block below only match
    // this one, and are therefore fully denied to every client, including
    // Admin — Admin-only server operations use the Admin SDK, which
    // bypasses these rules entirely.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- users/{uid} ----------
    // role is set exclusively by Cloud Functions (provisionStaffUser or
    // the customer sign-up trigger), never by any client write.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, delete: if false; // Function (Admin SDK) only
      allow update: if isOwner(uid) && onlyChanging(['displayName', 'phone']);
      // Explicit privilege-escalation guard (belt-and-suspenders): even
      // though 'role' is excluded from onlyChanging above, this makes the
      // intent unambiguous for anyone reading the rules.
      allow update: if isOwner(uid)
        && !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ---------- customerProfiles/{uid} ----------
    match /customerProfiles/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isFinance();
      allow create, delete: if false; // Function (sign-up trigger) only
      allow update: if isOwner(uid)
        && onlyChanging(['name', 'phone', 'email', 'defaultAddressId'])
        && (
          !('defaultAddressId' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.defaultAddressId == null
          || get(/databases/$(database)/documents/addresses/$(request.resource.data.defaultAddressId)).data.customerId == request.auth.uid
        );
    }

    // ---------- addresses/{addressId} ----------
    match /addresses/{addressId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId; // ownership immutable
      allow delete: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // ---------- riders/{riderId} (skeleton profile only in Phase 1) ----------
    match /riders/{riderId} {
      allow read: if isOwner(riderId) || isAdmin();
      allow create, delete: if false; // Function (provisionStaffUser) only
      allow update: if (isOwner(riderId) && onlyChanging(['active'])) || isAdmin();
    }

    // ---------- auditLogs ----------
    // No client path at all, in any direction, for any role. Matches the
    // catch-all above by omission — listed here only as documentation.
    // match /auditLogs/{logId} { allow read, write: if false; }
  }
}
