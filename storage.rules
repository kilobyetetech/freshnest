rules_version = '2';

// FreshNest Laundry — Storage Security Rules
// Paths mirror the ownership model documented in the architecture (Section 9).
// The `receipts` path is testable now (ownership is fully determined by the
// path segments themselves). The remaining five paths require cross-checking
// orderId/incidentId/expenseId/refundId ownership against collections that
// don't exist until Phase 2/3/4 — those are deliberately left deny-all until
// then, with the exact intended rule documented in comments so Phase 2+ can
// implement them without re-deriving the model.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isFinance() {
      return hasRole('finance');
    }

    // Default deny for anything not explicitly matched.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // /receipts/{customerId}/{orderId}/{fileName}
    // Fully enforceable now: ownership is determined entirely by the
    // customerId path segment, no cross-collection lookup required.
    match /receipts/{customerId}/{orderId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == customerId || isFinance() || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == customerId;
      allow update, delete: if false; // receipts are append-only evidence
    }

    // Phase 3 evidence files are scoped through Firestore ownership checks.
    match /proofOfDelivery/{orderId}/{fileName} {
      allow read: if isSignedIn() && (firestore.get(/databases/(default)/documents/orders/$(orderId)).data.customerId == request.auth.uid || isAdmin() || (hasRole('rider') && firestore.get(/databases/(default)/documents/deliveryJobs/$(orderId)).data.assignedRiderId == request.auth.uid));
      allow create: if hasRole('rider') && firestore.get(/databases/(default)/documents/deliveryJobs/$(orderId)).data.assignedRiderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /signatures/{orderId}/{fileName} {
      allow read: if isSignedIn() && (firestore.get(/databases/(default)/documents/orders/$(orderId)).data.customerId == request.auth.uid || isAdmin() || (hasRole('rider') && firestore.get(/databases/(default)/documents/deliveryJobs/$(orderId)).data.assignedRiderId == request.auth.uid));
      allow create: if hasRole('rider') && firestore.get(/databases/(default)/documents/deliveryJobs/$(orderId)).data.assignedRiderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /incidentPhotos/{incidentId}/{fileName} {
      allow read, create: if isAdmin() || hasRole('staff') || (isSignedIn() && firestore.get(/databases/(default)/documents/incidents/$(incidentId)).data.reportedByUid == request.auth.uid);
      allow update, delete: if false;
    }

    // /expenseReceipts/{expenseId}/{fileName} — deferred to Phase 4, but
    // role-only (no per-document ownership needed) so this could be
    // enabled early; left deny-all for consistency with "no premature
    // feature surface area" until expenses ship.
    match /expenseReceipts/{expenseId}/{fileName} {
      allow read, write: if false;
    }

    // /refundEvidence/{refundId}/{fileName} — deferred to Phase 4.
    match /refundEvidence/{refundId}/{fileName} {
      allow read, write: if false;
    }
  }
}
